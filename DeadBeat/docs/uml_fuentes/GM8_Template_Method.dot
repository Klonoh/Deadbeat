digraph GM8_Template_Method {
	bgcolor=white dpi=200 fontcolor="#17232F" fontname="DejaVu Sans" fontsize=18 label="GM-8 | Template Method: ciclo común de armas" labeljust=l labelloc=t nodesep=.35 pad=.25 rankdir=LR ranksep=.65 splines=polyline
