digraph GM7_Strategy {
	bgcolor=white dpi=200 fontcolor="#17232F" fontname="DejaVu Sans" fontsize=18 label="GM-7 | Strategy: movimiento de zombies" labeljust=l labelloc=t nodesep=.35 pad=.25 rankdir=LR ranksep=.65 splines=polyline
	node [color="#5D7483" fillcolor="#F4F7F9" fontname="DejaVu Sans" fontsize=11 margin=".12,.09" shape=record style="rounded,filled"]
	edge [arrowsize=.75 color="#647989" fontname="DejaVu Sans" fontsize=9 penwidth=1.3]
	Strategy [label="{«interface» MovementStrategy|+move(Zombie, Player, float): void\l}" fillcolor="#EAF5F1"]
	Chase [label="{ChaseMovement|+move(...): void\l}" fillcolor="#F4F7F9"]
	Zig [label="{ZigzagMovement|+move(...): void\l}" fillcolor="#F4F7F9"]
	Zombie [label="{Zombie|−strategy: MovementStrategy\l+setMovementStrategy(...): void\l+update(...): void\l}" fillcolor="#EAF3F8"]
	Player [label="{Player|+getX(): float\l+getY(): float\l}" fillcolor="#F4F7F9"]
	Chase -> Strategy [arrowhead=empty color="#486879" style=dashed]
	Zig -> Strategy [arrowhead=empty color="#486879" style=dashed]
	Zombie -> Strategy [label=delega arrowhead=vee]
	Strategy -> Player [label=objetivo arrowhead=vee style=dashed]
}
