digraph GM3_Arquitectura {
	bgcolor=white dpi=200 fontcolor="#17232F" fontname="DejaVu Sans" fontsize=18 label="GM-3 | Arquitectura y clases LibGDX" labeljust=l labelloc=t nodesep=.35 pad=.25 rankdir=LR ranksep=.65 splines=polyline
	node [color="#5D7483" fillcolor="#F4F7F9" fontname="DejaVu Sans" fontsize=11 margin=".12,.09" shape=record style="rounded,filled"]
	edge [arrowsize=.75 color="#647989" fontname="DejaVu Sans" fontsize=9 penwidth=1.3]
	Game [label="{«LibGDX» Game|+create(): void\l+setScreen(Screen): void\l}" fillcolor="#E9EDF5"]
	ScreenAdapter [label="{«LibGDX» ScreenAdapter|+render(float): void\l+dispose(): void\l}" fillcolor="#E9EDF5"]
	DeadbeatGame [label="{DeadbeatGame|+create(): void\l+dispose(): void\l}" fillcolor="#EAF3F8"]
	Menu [label="{MainMenuScreen|+render(float): void\l}" fillcolor="#F4F7F9"]
	Screen [label="{GameScreen|+render(float): void\l+checkRunOutcome(): void\l}" fillcolor="#F4F7F9"]
	World [label="{GameWorld|+update(float): void\l+draw(...): void\l+reset(): void\l}" fillcolor="#EAF3F8"]
	Audio [label="{AudioSettings|+getInstance(): AudioSettings\l}" fillcolor="#EAF5F1"]
	Sound [label="{SoundtrackPlayer|+update(): void\l}" fillcolor="#F4F7F9"]
	DeadbeatGame -> Game [arrowhead=empty color="#486879" style=solid]
	Menu -> ScreenAdapter [arrowhead=empty color="#486879" style=solid]
	Screen -> ScreenAdapter [arrowhead=empty color="#486879" style=solid]
	DeadbeatGame -> Menu [label="pantalla inicial" arrowhead=vee]
	Menu -> Screen [label=inicia arrowhead=vee style=dashed]
	Screen -> World [label=1 arrowhead=none arrowtail=diamond dir=both]
	Menu -> Audio [arrowhead=vee]
	Screen -> Sound [arrowhead=none arrowtail=diamond dir=both]
	Sound -> Audio [arrowhead=vee]
}
