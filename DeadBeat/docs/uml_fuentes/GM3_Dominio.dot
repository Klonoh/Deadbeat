digraph GM3_Dominio {
	bgcolor=white dpi=200 fontcolor="#17232F" fontname="DejaVu Sans" fontsize=18 label="GM-3 | Modelo de dominio (principales relaciones)" labeljust=l labelloc=t nodesep=.35 pad=.25 rankdir=LR ranksep=.65 splines=polyline
	node [color="#5D7483" fillcolor="#F4F7F9" fontname="DejaVu Sans" fontsize=11 margin=".12,.09" shape=record style="rounded,filled"]
	edge [arrowsize=.75 color="#647989" fontname="DejaVu Sans" fontsize=9 penwidth=1.3]
	World [label="{GameWorld|zombies: List\lprojectiles: List\lorbs: List\l+update(): void\l}" fillcolor="#EAF3F8"]
	Player [label="{Player|health: float\lexperience: int\lweapons: List\l}" fillcolor="#F4F7F9"]
	Zombie [label="{Zombie|type: ZombieType\lstrategy: MovementStrategy\l}" fillcolor="#F4F7F9"]
	Proj [label="{Projectile|damage: float\l}" fillcolor="#F4F7F9"]
	Orb [label="{ExperienceOrb|amount: int\l}" fillcolor="#F4F7F9"]
	Wave [label="{Wave|duration: float\lcounts: int\l}" fillcolor="#F4F7F9"]
	WaveB [label="{WaveBuilder|+normal(): WaveBuilder\l+fast(): WaveBuilder\l+tank(): WaveBuilder\l+build(): Wave\l}" fillcolor="#EAF3F8"]
	Upgrade [label="{UpgradeSelection|+award(int): void\l+choose(int, Player): void\l}" fillcolor="#F4F7F9"]
	Map [label="{CityMap|+collidesCircle(...): boolean\l}" fillcolor="#F4F7F9"]
	Damage [label="{«interface» Damageable|+takeDamage(float): void\l+isAlive(): boolean\l}" fillcolor="#EAF5F1"]
	Weapon [label="{«abstract» Weapon|+update(...): void\l#performAttack(...): boolean\l}" fillcolor="#EBF3F3"]
	Move [label="{«interface» MovementStrategy|+move(Zombie, Player, float): void\l}" fillcolor="#EAF5F1"]
	World -> Player [label=1 arrowhead=none arrowtail=diamond dir=both]
	World -> Zombie [label="0..*" arrowhead=none arrowtail=diamond dir=both]
	World -> Proj [label="0..*" arrowhead=none arrowtail=diamond dir=both]
	World -> Orb [label="0..*" arrowhead=none arrowtail=diamond dir=both]
	World -> Wave [label=5 arrowhead=vee]
	World -> Upgrade [label=1 arrowhead=none arrowtail=diamond dir=both]
	World -> Map [label=1 arrowhead=none arrowtail=diamond dir=both]
	Player -> Damage [arrowhead=empty color="#486879" style=dashed]
	Zombie -> Damage [arrowhead=empty color="#486879" style=dashed]
	Player -> Weapon [label=2 arrowhead=vee]
	Zombie -> Move [label=1 arrowhead=vee]
	WaveB -> Wave [label=crea arrowhead=vee style=dashed]
}
