digraph GM4_Abstraccion_Interfaz {
	bgcolor=white dpi=200 fontcolor="#17232F" fontname="DejaVu Sans" fontsize=18 label="GM-4 | Abstraccion, herencia y contrato de daño" labeljust=l labelloc=t nodesep=.35 pad=.25 rankdir=LR ranksep=.65 splines=polyline
	node [color="#5D7483" fillcolor="#F4F7F9" fontname="DejaVu Sans" fontsize=11 margin=".12,.09" shape=record style="rounded,filled"]
	edge [arrowsize=.75 color="#647989" fontname="DejaVu Sans" fontsize=9 penwidth=1.3]
	Weapon [label="{«abstract» Weapon|−damage: float\l−interval: float\l+update(...): void [final]\l#performAttack(...): boolean [abstract]\l}" fillcolor="#EBF3F3"]
	Electric [label="{ElectricGuitar|#performAttack(...): boolean\l}" fillcolor="#F4F7F9"]
	Drums [label="{Drumsticks|#performAttack(...): boolean\l}" fillcolor="#F4F7F9"]
	Damage [label="{«interface» Damageable|+takeDamage(float): void\l+isAlive(): boolean\l}" fillcolor="#EAF5F1"]
	Player [label="{Player|+updateWeapons(...): void\l}" fillcolor="#EAF3F8"]
	Zombie [label="{Zombie|+takeDamage(float): void\l}" fillcolor="#F4F7F9"]
	Electric -> Weapon [arrowhead=empty color="#486879" style=solid]
	Drums -> Weapon [arrowhead=empty color="#486879" style=solid]
	Player -> Damage [arrowhead=empty color="#486879" style=dashed]
	Zombie -> Damage [arrowhead=empty color="#486879" style=dashed]
	Player -> Weapon [label="colección" arrowhead=vee]
}
